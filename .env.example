# ============================================================
#  Alice Jarvis — переменные окружения для установки
#  Скопируйте в .env и заполните. .env в git не попадает.
# ============================================================

# ---------- Cloudflare (деплой воркера) ----------
# Токен: dash.cloudflare.com → My Profile → API Tokens
# Шаблон: "Edit Cloudflare Workers" (Workers Scripts:Edit)
CF_API_TOKEN=
# Account ID: правая колонка на главной странице дашборда
CF_ACCOUNT_ID=
# Имя воркера (латиница, дефисы)
WORKER_NAME=alice-jarvis-llm
# Пароль к вашему воркеру. Придумайте длинную случайную строку.
# Он же попадёт в runtime.env на колонке как QUASAR_LLM_API_KEY.
JARVIS_KEY=

# ---------- Колонка ----------
# IP:порт ADB (на Станции Лайт обычно 5555)
STATION_IP=192.168.1.50
STATION_ADB_PORT=5555
# Путь к adb.exe, если он не в PATH (оставьте пустым для автопоиска)
ADB_PATH=

# ---------- LLM ----------
# Адрес воркера выдаст scripts/deploy_worker.py после деплоя.
# Скопируйте его сюда и в config.json → llm_base_url.
LLM_BASE_URL=https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev/cf/v1
LLM_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct

# ---------- Необязательно: резервные провайдеры ----------
# Воркер умеет проксировать эти API (ключи живут в секретах воркера).
GROQ_KEY=
GEMINI_KEY=
OPENROUTER_KEY=
