# ============================================================
#  Окружение quasar-bridge на колонке.
#  Скопируйте в runtime.env и заполните. Файл в git не попадает.
#
#  ВАЖНО:
#   * каждая переменная — с export (start.sh подхватывает файл как shell);
#   * переводы строк только LF. CRLF ломает значения: "64MiB\r" роняет
#     бинарник, а ключ с \r не проходит авторизацию (воркер ответит 401).
# ============================================================

# Пароль к вашему воркеру. Должен совпадать с секретом JARVIS_KEY.
# Это тот же ключ, что вы задавали при деплое (scripts/deploy_worker.py).
export QUASAR_LLM_API_KEY=PASTE_YOUR_JARVIS_KEY_HERE

# На колонке всего ~238 МБ RAM: ограничиваем Go и оставляем одно ядро.
export GOMAXPROCS=1
export GOMEMLIMIT=64MiB

# Корневые сертификаты прошивки — без них HTTPS к Cloudflare не работает.
export SSL_CERT_FILE=/system/vendor/quasar/ca-certificates.crt

# Необязательно: MCP-сервер Home Assistant для инструментов моста.
# Оставьте пустым, если не используете.
export QUASAR_HOME_MCP_URL=
